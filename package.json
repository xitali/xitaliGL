{
  "name": "xitali-game-launcher",
  "version": "1.0.6",
  "description": "Launcher gier pozwalający na zarządzanie biblioteką gier z różnych platform",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu",
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "set NODE_ENV=development && concurrently \"npm run dev\" \"electron . --disable-gpu\"",
    "electron:build": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always",
    "postinstall": "npm install cheerio",
    "package": "npm run build && electron-packager . \"xitali Game Launcher\" --out=packaged-app-new --platform=win32 --arch=x64 --asar --icon=assets/icons/app-icon.ico --overwrite --ignore=\"(node_modules/sqlite3|node_modules/better-sqlite3)\"",
    "create-installer": "electron-installer-windows --src=packaged-app-new/xitali\\ Game\\ Launcher-win32-x64/ --dest=installers/ --config=installer-config.json"
  },
  "author": "Emanuel 'xitali' Włoch",
  "license": "MIT",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0",
    "electron-log": "^5.4.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.9.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.1.0",
    "electron-builder": "^24.6.4",
    "electron-installer-windows": "^3.0.0",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.xitali.gamelauncher",
    "productName": "xitali Game Launcher",
    "icon": "assets/icons/app-icon.ico",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "services/**/*",
      "assets/**/*",
      "index.html",
      "renderer.js"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "xgl.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xitali",
        "repo": "xitaliGL",
        "private": true,
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [],
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xitali/xitaliGL.git"
  }
}
